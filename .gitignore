# Dependencies
node_modules/
**/node_modules/

# Environment variables (per-service .env files — never commit secrets)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
docker-compose.override.yml.bak

# OS files
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Build output
dist/
build/
coverage/

# Uploaded media (runtime-generated, not source)
services/media-service/public/uploads/*
!services/media-service/public/uploads/.gitkeep

# Package manager lock artifacts (keep package-lock.json, ignore others if mixed)
yarn.lock
pnpm-lock.yaml

# Misc
*.pid
*.seed
*.pid.lock
.eslintcache